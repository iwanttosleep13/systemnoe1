//1 способ
public static int multiplyByAddition(int a, int b) {
    int result = 0;
    for (int i = 0; i < b; i++) {
        result = result + a;
    }
    return result;
}
//2 способ
public static int multiplyByLoop(int a, int b) {
    int result = 0;
    while (b > 0) {
        result = result + a;
        b--;
    }
    return result;
}
//3 способ
public static int multiplyByShift(int a, int b) {
    int result = 0;
    while (b > 0) {
        if (b % 2 == 1) {
            result = result + a;
        }
        a = a * 2;   // умножаем на 2 (да, мы типа умножаем, но не *)
        b = b / 2;   // делим на 2
    }
    return result;
}
//4 способ
public static int multiplyByLog(int a, int b) {
    if (a == 0 || b == 0) return 0;
    double result = Math.exp(Math.log(a) + Math.log(b));
    return (int) Math.round(result);
}
